                        </Size>
                        <MinSize>
                            <Height>600</Height>
                            <Width>380</Width>
                        </MinSize>
                        <MaxSize>
                            <Height>2400</Height>
                            <Width>900</Width>
                        </MaxSize>
                    </Geometry>
                    <Icons>
                        <Icon Type="Normal">./client/icons/icon.png</Icon>
                        <Icon Type="RollOver">./client/icons/icon.png</Icon>
                        <Icon Type="Darkest">./client/icons/icon.png</Icon>
                    </Icons>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
