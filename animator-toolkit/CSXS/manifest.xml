<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="9.0" ExtensionBundleId="com.cnn.animatortoolkit" ExtensionBundleVersion="0.1.1" ExtensionBundleName="Animator Toolkit" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <ExtensionList>
        <Extension Id="com.cnn.animatortoolkit.panel" Version="0.1.1" />
    </ExtensionList>
    <ExecutionEnvironment>
        <HostList>
            <Host Name="AEFT" Version="[18.0,99.9]" />
        </HostList>
        <LocaleList>
            <Locale Code="All" />
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="9.0" />
        </RequiredRuntimeList>
    </ExecutionEnvironment>
    <DispatchInfoList>
        <Extension Id="com.cnn.animatortoolkit.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./client/index.html</MainPath>
                    <ScriptPath>./host/index.jsx</ScriptPath>
                    <CEFCommandLine>
                        <Parameter>--enable-nodejs</Parameter>
                        <Parameter>--mixed-context</Parameter>
                    </CEFCommandLine>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>Animator Toolkit</Menu>
                    <Geometry>
                        <Size>
                            <Height>720</Height>
                            <Width>360</Width>
                        </Size>
                        <MinSize>
                            <Height>320</Height>
                            <Width>280</Width>
                        </MinSize>
                        <MaxSize>
                            <Height>2400</Height>
                            <Width>1200</Width>
                        </MaxSize>
                    </Geometry>
                    <Icons>
                        <Icon Type="Normal">./client/icons/icon.png</Icon>
                        <Icon Type="RollOver">./client/icons/icon.png</Icon>
                        <Icon Type="Darkest">./client/icons/icon.png</Icon>
                    </Icons>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
